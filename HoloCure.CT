</AssemblerScript>
                  <CheatEntries>
                    <CheatEntry>
                      <ID>6</ID>
                      <Description>"Notes:"</Description>
                      <Color>808080</Color>
                      <GroupHeader>1</GroupHeader>
                      <CheatEntries>
                        <CheatEntry>
                          <ID>7</ID>
                          <Description>"If saved, states of the checkbox can be restored when CT is started next time."</Description>
                          <Color>808080</Color>
